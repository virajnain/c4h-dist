FROM almalinux:9

SHELL ["/bin/bash", "-c"]

RUN dnf -y update && \
    dnf install -y \
    git \
    gcc \
    gcc-c++ \
    gcc-gfortran \
    make \
    cmake \
    python3 \
    python3-pip \
    wget \
    tar \
    xz \
    bzip2 \
    which \
    file \
    patch \
    hostname \
    perl \
    procps-ng \
    openssl-devel \
    libuuid-devel \
    libX11-devel \
    libXpm-devel \
    libXft-devel \
    libXext-devel \
    mesa-libGL-devel \
    glibc-langpack-en && \
    dnf clean all

LABEL org.opencontainers.image.source="https://github.com/virajnain/c4h-dist"